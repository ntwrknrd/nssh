# ~/.ssh/config
#
# Main SSH configuration file with Include directives for nssh inventory.
# Group placement lives in nssh config; SSH files are the inventory backing store.

# Include other SSH config files
Include ~/.ssh/nssh.d/*

# Global defaults for all hosts
Host *
  LogLevel ERROR
  SetEnv TERM=xterm-256color
  SetEnv COLORTERM=truecolor
  ControlMaster auto
  ControlPath ~/.ssh/controlmasters/%r@%h:%p
  ControlPersist yes
  TCPKeepAlive yes
  ServerAliveInterval 240
  ServerAliveCountMax 2
  GSSAPIAuthentication no
  IdentityAgent None
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519
