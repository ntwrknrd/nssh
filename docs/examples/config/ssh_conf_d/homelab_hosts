# ~/.ssh/homelab_hosts
#
# Homelab environment SSH hosts.
# This file is referenced by the "homelab" context in nssh_credentials.age

Host k3s-a
  HostName k3s-a
  Port 22
  User root
  PubkeyAuthentication yes
  PasswordAuthentication no

Host k3s-b
  HostName k3s-b
  Port 22
  User root
  PubkeyAuthentication yes
  PasswordAuthentication no

Host k3s-c
  HostName k3s-c
  Port 22
  User root
  PubkeyAuthentication yes
  PasswordAuthentication no

Host pve01
  HostName 192.0.2.100
  Port 22
  User root
  PubkeyAuthentication yes
  PasswordAuthentication no

Host rpi-a
  HostName rpi-a
  Port 22
  User alice
  PubkeyAuthentication yes
  PasswordAuthentication no
