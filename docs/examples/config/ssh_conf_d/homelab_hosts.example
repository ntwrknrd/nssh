# ~/.ssh/nssh.d/provider_local.conf
#
# Local-provider homelab hosts.
# Credential fallback is configured through inventory.group.homelab.auth.

Host k3s-a
  # Group: homelab
  HostName k3s-a.lan.example.net
  Port 22
  User root
  PubkeyAuthentication yes
  PasswordAuthentication no

Host k3s-b
  # Group: homelab
  HostName k3s-b.lan.example.net
  Port 22
  User root
  PubkeyAuthentication yes
  PasswordAuthentication no

Host k3s-c
  # Group: homelab
  HostName k3s-c.lan.example.net
  Port 22
  User root
  PubkeyAuthentication yes
  PasswordAuthentication no

Host pve01
  # Group: homelab
  HostName 192.0.2.100
  Port 22
  User root
  PubkeyAuthentication yes
  PasswordAuthentication no

Host rpi-a
  # Group: homelab
  HostName rpi-a.lan.example.net
  Port 22
  User alice
  PubkeyAuthentication yes
  PasswordAuthentication no
