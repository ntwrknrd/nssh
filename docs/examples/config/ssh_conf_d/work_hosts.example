# ~/.ssh/nssh.d/provider_local.conf
#
# Local-provider work hosts.
# Credential fallback is configured through inventory.group.work.auth.

Host legacy-switch
  # Group: work
  HostName legacy-switch.example.com
  Port 22
  User alice
  PubkeyAuthentication no
  PreferredAuthentications keyboard-interactive
  HostKeyAlgorithms +ssh-rsa
  KexAlgorithms +diffie-hellman-group-exchange-sha1,diffie-hellman-group14-sha1,diffie-hellman-group1-sha1
  Ciphers +aes256-cbc,aes192-cbc,aes128-cbc

Host switch
  # Group: work
  HostName switch.example.com
  Port 22
  User alice
  PubkeyAuthentication no
  PreferredAuthentications keyboard-interactive

Host server
  # Group: work
  HostName server.example.com
  Port 22
  User alice
  PubkeyAuthentication yes
  PreferredAuthentications publickey,password,keyboard-interactive

Host router
  # Group: work
  HostName router.example.com
  Port 22
  User alice
  PubkeyAuthentication no
  PreferredAuthentications password
