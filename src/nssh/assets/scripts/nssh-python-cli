#!/usr/bin/env python3
"""Lightweight shim that executes the nssh Typer CLI."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def _uv_tool_python() -> Path | None:
    path = Path.home() / ".local" / "share" / "uv" / "tools" / "nssh" / "bin" / "python"
    if path.exists():
        return path
    return None


def _ensure_repo_path() -> None:
    script_dir = Path(__file__).resolve().parent
    repo_root = script_dir.parent.parent
    package_dir = repo_root / "nssh"
    if package_dir.exists():
        sys.path.insert(0, str(repo_root))


def _exec_tool_python() -> None:
    candidate = _uv_tool_python()
    if candidate is None:
        raise ModuleNotFoundError("nssh package not installed; run 'uv tool install .' or add the repo to PYTHONPATH")
    os.execv(
        str(candidate),
        [
            str(candidate),
            "-m",
            "nssh.cli.main",
            *sys.argv[1:],
        ],
    )


def main() -> None:
    # Fast path: if invoked with a host argument (not a CLI command),
    # call connect directly to avoid CLI module import overhead
    args = sys.argv[1:]
    if args:
        first_arg = args[0]
        # List of top-level CLI commands
        cli_commands = {
            "connect", "host", "cred", "log", "benchmark",
            "install-shell", "recording-check", "help", "version",
            "__list-subcommands", "--"
        }
        # If first arg is not a flag and not a CLI command, it's a host -> fast path
        if not first_arg.startswith("-") and first_arg not in cli_commands:
            try:
                from nssh.core.connect import main as connect_main
            except ModuleNotFoundError:
                _ensure_repo_path()
                try:
                    from nssh.core.connect import main as connect_main
                except ModuleNotFoundError:
                    _exec_tool_python()
                    raise
            connect_main(argv=args)
            return

    # Normal path: invoke CLI for management commands
    try:
        from nssh.cli.main import main as cli_main
    except ModuleNotFoundError:
        _ensure_repo_path()
        try:
            from nssh.cli.main import main as cli_main
        except ModuleNotFoundError:
            _exec_tool_python()
            raise

    cli_main(args)


if __name__ == "__main__":  # pragma: no cover
    main()
