# nssh Environment Variables
#
# Copy to ~/.config/nssh/.env or export directly in your shell profile.
# Environment variables override config.toml settings.

# ============================================================================
# GENERAL
# ============================================================================

# Config file path (default: ~/.config/nssh/config.toml)
# NSSH_CONFIG=/path/to/config.toml

# Default context for new hosts (used by `nssh host add`)
# NSSH_DEFAULT_CONTEXT=work

# Default SSH username for new hosts
# NSSH_DEFAULT_USER=admin

# Enable timing/debug output (set to "1")
# NSSH_DEBUG=1

# ============================================================================
# PATHS
# ============================================================================

# Age encryption key file (default: ~/.config/age/keys.txt)
# NSSH_AGE_KEY=/path/to/keys.txt

# Encrypted credentials file (default: ~/.local/share/nssh/credentials.age)
# NSSH_CRED_FILE=/path/to/credentials.age

# SSH config file location (default: ~/.ssh/config)
# NSSH_SSH_CONFIG=/path/to/config

# SSH config include directory (default: ~/.ssh/conf.d)
# NSSH_SSH_CONF_INCLUDE=/path/to/conf.d

# Host index file location (default: ~/.local/state/nssh/host_index)
# NSSH_HOST_INDEX=/path/to/host_index

# Shell helpers directory (default: ~/.local/share/nssh)
# NSSH_SHARE_DIR=/path/to/share

# Backup files directory (default: ~/.local/share/nssh/backups)
# NSSH_BACKUP_DIR=/path/to/backups

# ============================================================================
# FISH SHELL
# ============================================================================

# Fish functions directory (default: ~/.config/fish/functions)
# NSSH_FISH_FUNCTIONS_DIR=/path/to/functions

# Fish completions directory (default: ~/.config/fish/completions)
# NSSH_FISH_COMPLETIONS_DIR=/path/to/completions

# ============================================================================
# SESSION RECORDING
# ============================================================================

# Enable/disable recording: 0=off, 1=on, force=fail if asciinema missing
# NSSH_RECORD=1

# Recording storage directory (default: ~/.local/state/nssh/casts)
# NSSH_RECORD_DIR=/path/to/casts

# Custom asciinema server URL (default: https://asciinema.org)
# ASCIINEMA_SERVER_URL=https://asciinema.example.com

# ============================================================================
# USAGE EXAMPLES
# ============================================================================
#
# Per-session overrides (prefix command):
#   NSSH_RECORD=0 nssh prod-server        # Don't record this session
#   NSSH_RECORD=1 nssh test-server        # Force recording this session
#   NSSH_RECORD_DIR=/tmp nssh lab-switch  # Save to /tmp for this session
#   NSSH_DEBUG=1 nssh router-01           # Show timing information
#
# Shell profile (~/.bashrc, ~/.zshrc, ~/.config/fish/config.fish):
#   export NSSH_DEFAULT_CONTEXT=homelab
#   export NSSH_DEFAULT_USER=admin
#   export NSSH_RECORD=1
#
# CI/CD pipelines:
#   NSSH_RECORD=force nssh deploy-target  # Fail if recording unavailable
